{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!node_modules", "!.opencode/node_modules", "!out", "!assets", "!prototype"]
	},
	"overrides": [
		{
			"includes": ["**/src/index.ts", "**/*.svg", "**/*.css"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedFunctionParameters": "off"
					},
					"a11y": {
						"noSvgWithoutTitle": "off"
					},
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["tools/**/*.html"],
			"linter": {
				"rules": {
					"suspicious": {
						// duplicate `image-rendering` lines are an intentional
						// fallback (crisp-edges then pixelated)
						"noDuplicateProperties": "off"
					}
				}
			}
		},
		{
			"includes": ["dist/**"],
			"linter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		},
		{
			"includes": ["dist/**/*.min.js"],
			"formatter": {
				"enabled": false
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "none",
			"arrowParentheses": "always"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "double"
		}
	},
	"html": {
		// experimental: enables formatting/linting of .html files, including
		// embedded <style> and <script> blocks (used by tools/)
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
